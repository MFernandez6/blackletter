# =============================================================================
# BLACKLETTER — Contract & document generation
# Local: copy to `.env` and `.env.local`
# =============================================================================

# SQLite local default. On Vercel the build seeds prisma/dev.db and copies
# it to /tmp at runtime. For durable prod data, point this at Postgres.
DATABASE_URL="file:./dev.db"

# NextAuth — local default. On Vercel, set the production URL
# (https://your-app.vercel.app) or leave unset so the build uses VERCEL_URL.
# An empty string throws TypeError: Invalid URL during `next build`.
NEXTAUTH_URL="http://localhost:3004"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Inbound service key (BLACKBOX next-document, suite callers)
BLACKLETTER_API_KEY="dev-letter-key"

# BLACKBOX — claim / claimant pull for merge fields
BLACKBOX_API_URL="http://localhost:3000"
BLACKBOX_API_KEY=
# When unset or BLACKBOX_DRY_RUN=1, claim pull uses local ClaimMirror rows.
# Executed documents still file into the BLACKBOX vault when the URL +
# BLACKLETTER_API_KEY are set (same key BLACKBOX checks on ingest).
BLACKBOX_DRY_RUN=1
# Public URL used when linking back to a claim
NEXT_PUBLIC_BLACKBOX_URL="http://localhost:3000"

# BLACKMIRROR — photo / scope data for estimate and demand packages
BLACKMIRROR_API_URL="http://localhost:3001"
BLACKMIRROR_API_KEY=

# BLACKGATE — intake documents already on file (do not regenerate)
BLACKGATE_API_URL="http://localhost:3002"
BLACKGATE_API_KEY=

# BLACKLEDGER — create payout on executed settlement / release
BLACKLEDGER_API_URL="http://localhost:3003"
BLACKLEDGER_API_KEY="dev-ledger-key"

# Google Workspace — create a Google Doc and share it with the claimant
# for Workspace eSignature. When unset, send stays in dry-run (status only).
#
# Preferred: service account with domain-wide delegation.
# GCP → service account JSON, then Workspace Admin → Security → API controls
# → Domain-wide delegation. Client ID + scopes:
#   https://www.googleapis.com/auth/drive
#   https://www.googleapis.com/auth/documents
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Workspace user the app impersonates (files land in this Drive)
GOOGLE_WORKSPACE_DELEGATE=
# Optional parent folder (shared drive or My Drive folder id)
GOOGLE_DRIVE_FOLDER_ID=
#
# Alternative to a service account: OAuth refresh token for a staff mailbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Legacy SignWell (unused for send). Webhook kept for existing events.
SIGNWELL_API_KEY=
SIGNWELL_API_URL="https://www.signwell.com/api/v1"
SIGNWELL_WEBHOOK_ID=
SIGNWELL_TEST_MODE=1
SIGNWELL_WEBHOOK_URL="http://localhost:3004/api/webhooks/signwell"

# Optional extra copy of files. Drafts already live in the database.
# Production send uses Google Drive, so these are not required on Vercel.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_USE_SIGNED_URLS=

UPLOAD_DIR="public/uploads"

# Seed is destructive — never run against production without this flag
# ALLOW_DESTRUCTIVE_SEED=1
